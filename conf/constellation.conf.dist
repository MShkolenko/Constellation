###############################################################################
# Constellation — configuration keys
#
# Phase 0: keys are read from worldserver.conf under the Constellation.* prefix.
# This file documents them; copy the lines you change into worldserver.conf.
#
# A KEY THE CODE READS AND THE CONFIG DOES NOT DECLARE FAILS THE DEPLOY GATE, and
# that is by design rather than by accident: the gate boots a probe world on the
# new binary beside one on the current binary and compares their startup output.
# A newly read key adds one "Missing name ..." line that the old binary cannot
# produce, the channels differ, and the swap is refused with the live realm
# untouched. So a new key is added HERE and to worldserver.conf in the same
# change as the code that reads it — otherwise the gate stops the deploy, which
# is exactly what happened to Constellation.EngineStrategies on 2026-09-10.
###############################################################################

#
#    Constellation.Enable
#        Description: Master switch. With 0 the module registers, announces
#                     itself in the startup log and does nothing else.
#        Default:     0
#

Constellation.Enable = 0

#
#    Constellation.Engine
#        Description: Lets the bid-queue engine DECIDE inside the Idle branch:
#                     it runs first, and the ladder's Idle body runs only when
#                     the engine had nothing to try. Off, the engine is not
#                     ticked at all and any state it held is forgotten.
#        Default:     0
#

Constellation.Engine = 0

#
#    Constellation.EngineShadow
#        Description: The engine decides WITHOUT executing, beside the ladder,
#                     and logs what it would have done against what the ladder
#                     is doing. Independent of Constellation.Engine on purpose:
#                     the shadow is meant to run on the whole roster, while the
#                     seam is enabled only once there is something to execute.
#        Default:     0
#

Constellation.EngineShadow = 0

#
#    Constellation.EngineStrategies
#        Description: Which engine strategies may bid, as a bitmask. ZERO MEANS
#                     NONE, which is a second lock independent of
#                     Constellation.Engine: with the flag on and this at zero
#                     the seam is silent, because nothing bids. This is the
#                     staging unit — one capability at a time, globally for the
#                     whole roster rather than for a subset of companions.
#
#                     Bits follow the strategy list in the engine's own header:
#                     1 = Survival, 2 = Quests, 4 = Combat, 8 = Trade,
#                     16 = Housekeeping, 32 = Follow.
#        Default:     0
#

Constellation.EngineStrategies = 0

#
#    Constellation.PathClear
#        Description: Path clearing. A companion on an errand pulls, one at a
#                     time, the aggressive creatures whose aggro reaches the
#                     next 40 yards of its route instead of running through
#                     them; with only strong ones on the route the errand waits
#                     (at most two three-minute waits in any ten minutes).
#                     Read at .reload config.
#        Default:     1
#

Constellation.PathClear = 1

#
#    Constellation.Squads
#        Description: Squads. Companions sharing an open quest group with each
#                     other through the core party (up to five, levels within
#                     two), follow the leader's travel spot and fight for a
#                     squad-mate. Off stops inviting, following and assisting;
#                     a formed group is not dissolved by the switch.
#                     Read at .reload config.
#        Default:     1
#

Constellation.Squads = 1

#
#    Constellation.Talents
#        Description: Talents. From level 10 a companion without a specialization
#                     picks the first damage spec of its class, then switches on
#                     the client's Starter Build for that spec (the client packet
#                     of the Starter Build button) and renews it at every new
#                     level. Off leaves specs and talents as they are.
#                     Read at .reload config.
#        Default:     1
#

Constellation.Talents = 1

#
#    Constellation.Pets
#        Description: Pets. A companion out of combat, alive and without a pet
#                     summons one (warlock Imp/Voidwalker, hunter Call Pet). A
#                     hunter of level 5+ with no pet at all is given a random
#                     local tameable creature through the core's own tame
#                     sequence, at most once per ten minutes.
#                     Read at .reload config.
#        Default:     1
#

Constellation.Pets = 1

#
#    Constellation.Groups
#        Bitmask of the roster groups brought into the world (operator 2026-09-30). Group 0 is the 17
#        newborns, group 1 the 17 born at level 10, group 2 the 17 born at level 20, each with its own
#        account, landing hubs and born kit (Roster.h, BornGear.h). 1 = newborns only (the old state),
#        7 = all three. Changing it needs a restart; a disabled group is neither created nor wiped.
#        Default: 1
#

Constellation.Groups = 1
